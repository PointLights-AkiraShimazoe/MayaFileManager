         return ""
 
 
+def _safe_child_prefix(model, parent_index):
+    """parent_index の «子» のパスの頭を返す（v0.9.20、並べ替え・絞り込みの軽量化）。
+
+    約束: 有効な子 index について、必ず
+        _safe_file_path(model, 子) == _join_child_prefix(これ, model.fileName(子))
+    になる。組み立て方は _safe_file_path と同じ（fileName を親方向へ辿る・
+    ドライブ名の正規化）。**_safe_file_path を直す時は必ずこちらも揃えること。**
+    test_sort_filter_path_memo が実際のモデルで両者を突き合わせている。
+
+    なぜ要るか: 並べ替え（lessThan）と絞り込み（filterAcceptsRow）は 1 回の
+    移動で数万回呼ばれ、そのたびに «同じ親» のパスを根まで辿り直していた。
+    親の分を 1 回だけ作っておけば、子は文字列を 1 回つなぐだけで済む。
+
+    親が無効、または組み立てに失敗した時は None（呼び出し側は従来の
+    _safe_file_path へ落ちる）。"""
+    try:
+        if parent_index is None or not parent_index.isValid():
+            return None
+        names = []
+        idx = parent_index
+        while idx.isValid():
+            names.append(model.fileName(idx))
+            idx = idx.parent()
+        names.reverse()
+        if not names:
+            return None
+        top = names[0]
+        m = _DRIVE_IN_LABEL_RE.search(top)
+        if m:
+            names[0] = m.group(1).upper() + ":"
+        elif len(top) == 2 and top[1] == ":":
+            names[0] = top[0].upper() + ":"
+        if names[0] == "/":                     # POSIX ルート
+            return "/" + "".join(n + "/" for n in names[1:])
+        return "/".join(names) + "/"
+    except Exception:
+        return None
+
+
+def _join_child_prefix(prefix: str, name: str) -> str:
+    """_safe_child_prefix の頭に子の名前をつないで、_safe_file_path と同じ
+    文字列にする（末尾の «2 文字で : 終わりなら / を足す» まで同じ）。"""
+    p = prefix + name
+    if len(p) == 2 and p.endswith(":"):
+        p += "/"
+    return p
+
+
