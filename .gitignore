*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── PyInstaller ───────────────────────────────────
# ビルド成果物
dist/
build/
*.spec.bak

# ── 仮想環境 ──────────────────────────────────────
.venv/
venv/
env/
.env

# ── MayaFileManager 設定（ユーザーローカル） ───────
