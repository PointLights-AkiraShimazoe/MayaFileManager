# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── PyInstaller ───────────────────────────────────
# ビルド成果物
dist/
build/
*.spec.bak

# ── 仮想環境 ──────────────────────────────────────
.venv/
venv/
env/
.env

# ── MayaFileManager 設定（ユーザーローカル） ───────
# ホームディレクトリに保存されるので通常は不要だが念のため
.maya_file_manager/

# ── IDE ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*~

# ── OS ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Maya バックアップ ─────────────────────────────
*.mfm_bak

# ── ログ ──────────────────────────────────────────
*.log
mfm_freeze.log

# ── コード構造図（Archify のローカル複製・受領ログ） ──
docs/_archify/
docs/diagrams/archify_report.txt
docs/diagrams/.archify-*

# Archify の中間生成物（図の配信用一時ディレクトリ。成果物は docs/*.html のみ追跡する）
docs/.archify-delivery-*/

# Cowork がテスト実行用に一時的に作る梱包ファイル（コミット対象外）
_mfm_src_for_tests.tgz
_mfm_stage.tgz
selfcheck.txt

# 書き戻しの経由ファイル（接続フォルダでは削除できないので無視する）
_mfm_*.tgz
_fbx_probe_*.fbx

# ── テスト自動実行（r146 の watcher 運用）の合図ファイル ────────────
# tools\mfm_test_watcher.ps1 が見張る。中身は一時的なものなので残さない。
.run_tests_request
.run_tests_running
.run_tests_done
.run_tests_only
mfm_tests_sel.log
.run_git_request
.run_git_done
.run_git_out.log

# デザインの作業ファイル（生成画像・下書き。採用分は resources/icons へ）
design/
tests/offscreen/_hold_*
